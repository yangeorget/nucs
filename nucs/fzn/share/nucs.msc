{
  "id": "org.nucs.nucs",
  "name": "NuCS",
  "description": "Fast constraint solving in Python",
  "version": "14.1.0",
  "mznlib": "./minizinc/nucs",
  "executable": "fzn-nucs",
  "tags": ["cp", "int"],
  "stdFlags": ["-a", "-f", "-i", "-n", "-s", "-t"],
  "extraFlags": [
    ["--last-conflict", "branch first on the variable of the last refuted decision (default with -f)", "bool", "false"],
    ["--no-last-conflict", "do not use last-conflict, even with -f", "bool", "false"],
    ["--restart", "restart policy POLICY[,SCALE[,BASE]], e.g. luby,500 (default luby,500 with -f)", "string", ""]
  ],
  "supportsMzn": false,
  "supportsFzn": true,
  "needsSolns2Out": true,
  "needsMznExecutable": false,
  "needsStdlibDir": false,
  "isGUIApplication": false
}
