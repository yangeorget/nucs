{
  "id": "org.nucs.nucs",
  "name": "NuCS",
  "description": "Fast constraint solving in Python",
  "version": "14.1.0",
  "mznlib": "./minizinc/nucs",
  "executable": "fzn-nucs",
  "tags": ["cp", "int"],
  "stdFlags": ["-a", "-i", "-n", "-s", "-t"],
  "supportsMzn": false,
  "supportsFzn": true,
  "needsSolns2Out": true,
  "needsMznExecutable": false,
  "needsStdlibDir": false,
  "isGUIApplication": false
}
